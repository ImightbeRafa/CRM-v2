{
  // Tiny redirect-only Worker for the bare domain. Deploy from this folder:
  //   npx wrangler deploy --config cloudflare/apex-redirect/wrangler.jsonc
  // It never touches the app Worker or its container.
  "name": "betsy-apex-redirect",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "betsycrm.com/*", "zone_name": "betsycrm.com" }
  ]
}
