# Betsy CRM - Environment Configuration
# Copy this file to .env.local and configure your settings

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# NextAuth.js Secret (REQUIRED)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Application URL
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL
# For SQLite: file:./dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/betsy
DATABASE_URL=file:./dev.db

# =============================================================================
# QUICK START
# =============================================================================

# 1. Copy this file to .env.local
# 2. Set NEXTAUTH_SECRET to a random string
# 3. Run: npm run db:push
# 4. Run: npm run db:setup
# 5. Run: npm run dev
# 6. Visit: http://localhost:3000
# 7. Login with: admin / admin123