# Betsy CRM - Production Environment Configuration
# Copy these variables to your Vercel project settings

# =============================================================================
# REQUIRED SETTINGS FOR VERCEL
# =============================================================================

# NextAuth.js Configuration
NEXTAUTH_SECRET=your-production-secret-key-here
NEXTAUTH_URL=https://betsycrm.com

# Database Configuration (Use Vercel Postgres or external database)
DATABASE_URL=postgresql://username:password@host:port/database

# =============================================================================
# AUTHENTICATION SETTINGS (USERNAME-BASED)
# =============================================================================

# Master user configuration for initial setup
AUTH_DEMO_MODE=false
MASTER_USERNAME=admin
MASTER_PASSWORD=your-secure-master-password

# =============================================================================
# IMPORTANT NOTES
# =============================================================================

# 1. The system uses USERNAME for authentication, not email
# 2. MASTER_USERNAME is the initial admin username
# 3. Users login with username/password, not email
# 4. The system supports multiple users with different roles (MASTER, REGULAR)

# =============================================================================
# SECURITY RECOMMENDATIONS
# =============================================================================

# - Use a strong, unique NEXTAUTH_SECRET (32+ characters)
# - Use a secure master password
# - Ensure your database is properly secured
# - Consider using environment-specific configurations
