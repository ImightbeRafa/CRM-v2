generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Core business models
model Order {
  id            String   @id @default(cuid())
  orderId       String   @unique
  orderType     String   // EA or RA
  status        String   @default("Pendiente")
  timestamp     DateTime @default(now())
  customerName  String
  phone         String?
  email         String?
  business      String?
  product       String?
  quantity      Int      @default(0)
  size          String?
  color         String?
  packaging     String?
  comments      String?
  total         Float    @default(0)
  iva           Float?
  shippingCost  Float?
  productCost   Float?
  address       String?
  province      String?
  canton        String?
  district      String?
  courier       String?
  expectedDate  String?
  agreedDate    String?
  pickupDate    String?
  saleDate      String?
  seller        String?

  @@index([status])
  @@index([orderType])
  @@index([timestamp])
  @@index([customerName])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      UserRole @default(REGULAR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([role])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  entityName String?
  oldValues  Json?
  newValues  Json?
  reason     String?
  userId     String
  userName   String
  userRole   UserRole
  timestamp  DateTime    @default(now())

  @@index([action])
  @@index([entityType])
  @@index([userId])
  @@index([timestamp])
}

model FrequentProduct {
  id          String   @id @default(cuid())
  name        String
  type        String
  color       String?
  tamano      String?
  baseCost    Float
  isFavorite  Boolean  @default(false)
  lastUsed    DateTime @default(now())
  useCount    Int      @default(0)
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([isFavorite])
  @@index([useCount])
}

model FrequentCustomer {
  id           String   @id @default(cuid())
  name         String
  phone        String
  province     String
  canton       String
  district     String
  email        String?
  username     String?
  address      String?
  business     String?
  totalOrders  Int      @default(0)
  lastOrder    DateTime @default(now())
  active       Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@index([totalOrders])
  @@index([lastOrder])
}

enum UserRole {
  MASTER
  REGULAR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  BULK_DELETE
  BULK_UPDATE
  BULK_TOGGLE
}