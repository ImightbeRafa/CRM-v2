generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// MULTI-TENANCY MODELS (NEW!)
// ============================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique  // For subdomain: mybiz.betsycrm.com
  plan      SubscriptionTier @default(FREE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Business Profile (for registration/verification)
  businessName      String?   // Company/business name
  ownerName         String?   // Owner's full name
  phone             String?   // Primary contact phone
  phoneVerified     Boolean   @default(false)
  phoneVerifiedAt   DateTime?
  phoneVerificationCode       String?   // Hashed OTP code
  phoneVerificationCodeExpires DateTime?
  phoneVerificationAttempts   Int       @default(0)
  country           String?   // Country code (e.g., "CR" for Costa Rica)
  province          String?   // Province/State
  profileCompleted  Boolean   @default(false)  // True when all required info is filled
  
  // Settings
  settings  Json?    // Tenant-specific configuration
  
  // Bot Access Code (for Telegram/WhatsApp team access)
  botAccessCode String? @unique  // e.g., "ABC123XYZ789" - share with team
  
  // Billing fields (Tilopay)
  tilopaySubscriptionId String?  // Tilopay Repeat subscription ID
  tilopayCustomerId     String?  // Tilopay customer ID for saved cards
  
  subscriptionStatus    String?  // active, canceled, past_due, trialing, trial_expired, payment_failed
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)
  trialEndsAt           DateTime? // 15-day trial end date
  
  // Relations
  memberships    Membership[]
  orders         Order[]
  clients        Client[]
  inventoryItems InventoryItem[]
  sellers        Seller[]
  shippingMethods ShippingMethod[]
  productFields  ProductField[]
  socialAccounts SocialAccount[]
  chatMessages   ChatMessage[]
  productOptionSets ProductOptionSet[]
  productOptions ProductOption[]
  businessInfo   BusinessInfo[]
  orderStatuses  OrderStatus[]
  shippingConfigs ShippingConfig[]
  shippingGuias  ShippingGuia[]
  auditLogs      AuditLog[]
  billingTransactions BillingTransaction[]
  invoices       Invoice[]
  usageLogs      UsageLog[]
  webhookLogs    WebhookLog[]
  apiKeys        ApiKey[]
  integrationLogs IntegrationLog[]
  botSessions    BotSession[]
  botInboxMessages BotInboxMessage[]
  feedbackTickets FeedbackTicket[]
  changelogEntries ChangelogEntry[]
  featureFlags    TenantFeatureFlag[]
  clientIdentityConflicts ClientIdentityConflict[]
  orderLifecycleOperations OrderLifecycleOperation[]
  orderInventoryAllocations OrderInventoryAllocation[]
  orderStatusClassifications TenantOrderStatusClassification[]
  
  @@index([slug])
  @@index([isActive])
}

// Additive, database-controlled feature flags. `scope` is either `global` or
// a tenant id, allowing a global kill switch without overloading tenant data.
model TenantFeatureFlag {
  id        String   @id @default(cuid())
  scope     String
  tenantId  String?
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([scope, key])
  @@index([tenantId])
  @@index([key, enabled])
}

model Membership {
  id       String   @id @default(cuid())
  role     MemberRole @default(VIEWER)
  userId   String
  tenantId String
  isActive Boolean  @default(true)
  invitedBy String? // User ID who sent invitation
  invitedAt DateTime?
  joinedAt  DateTime @default(now())
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

enum MemberRole {
  OWNER      // Full access, billing, delete tenant
  ADMIN      // Full access except billing
  MANAGER    // Sales + Production + Stats
  SALES      // /ventas only
  PRODUCTION // /produccion only
  VIEWER     // Read-only access
}

enum SubscriptionTier {
  FREE       // 1 user, unlimited orders, basic features
  BASIC      // 5 users, unlimited orders, reports
  PRO        // 25 users, unlimited orders, API access
  ENTERPRISE // Unlimited everything, custom domains
}

// ============================================================================
// CORE BUSINESS MODELS (Updated with tenantId)
// ============================================================================

model Order {
  id            String   @id @default(cuid())
  tenantId      String   // NEW: Tenant isolation
  orderId       String   // No longer @unique globally - unique per tenant
  orderType     String   // EA or RA
  status        String   @default("Pendiente")
  timestamp     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  customerName  String
  
  // User identification for the order creator/owner
  username      String?
  phone         String?
  email         String?
  business      String?
  product       String?
  quantity      Int      @default(0)
  size          String?
  color         String?
  packaging     String?
  
  // Additional customization details and funnel/source
  customization String?
  comments      String?
  total         Float    @default(0)
  iva           Float?
  shippingCost  Float?
  productCost   Float?
  address       String?
  province      String?
  canton        String?
  district      String?
  courier       String?
  expectedDate  String?
  
  // Sales/marketing funnel
  funnel        String?
  agreedDate    String?
  pickupDate    String?
  saleDate      String?
  seller        String?
  salesChannel  String?
  
  // Delivery status or method
  delivery      String?
  
  // Detailed product information for inventory updates
  productDetails String?
  
  // Tenant-defined dynamic custom fields
  customFields  Json?

  // Contra entrega (cash on delivery)
  contraEntrega      Boolean @default(false)
  cePaymentConfirmed Boolean @default(false)

  // Betsy v2 linkage. Nullable so the currently deployed application keeps
  // working before tenant-by-tenant client reconciliation is approved.
  clientId        String?
  lifecycleVersion Int      @default(1)

  // Betsy v2 archival. Nullable/additive so old code keeps working. Restoring
  // only clears deletedAt on this same row; related business side effects are
  // never replayed from audit JSON.
  deletedAt       DateTime?
  deletedBy       String?
  deleteReason    String?    @db.Text
  archiveMetadata Json?
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]  // Orders can have invoices
  chatMessages ChatMessage[]
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  identityConflicts ClientIdentityConflict[]
  lifecycleOperations OrderLifecycleOperation[]
  inventoryAllocations OrderInventoryAllocation[]
  
  @@unique([tenantId, orderId]) // Unique within tenant
  @@index([tenantId, deletedAt, timestamp])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, orderType])
  @@index([tenantId, timestamp])
  @@index([tenantId, timestamp, id])
  @@index([tenantId, status, timestamp, id])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, customerName])
  @@index([tenantId, contraEntrega])
  @@index([tenantId, clientId])
}

model User {
  // Basic info
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?
  password  String?
  
  // Profile
  name      String?
  image     String?
  emailVerified DateTime? @map("emailVerified")
  emailVerificationToken String? @map("emailVerificationToken")
  emailVerificationTokenExpires DateTime? @map("emailVerificationTokenExpires")
  // Old snake_case fields - these should be removed after migration
  email_verification_token String? @map("email_verification_token")
  email_verification_token_expires DateTime? @map("email_verification_token_expires")
  
  // Password reset
  passwordResetToken String? @map("passwordResetToken")
  passwordResetTokenExpires DateTime? @map("passwordResetTokenExpires")

  // OAuth
  provider  String?
  providerId String?
  
  // Settings
  active    Boolean  @default(false)
  isSuperAdmin Boolean @default(false) // Cross-tenant monitoring access
  isLogisticsAdmin Boolean @default(false) // Access to /logistics dashboard
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastActive DateTime?
  
  // Default tenant (for quick access)
  defaultTenantId String?
  
  // Relations
  memberships Membership[]
  auditLogs   AuditLog[]
  socialAccounts SocialAccount[]
  botSessions BotSession[]
  feedbackTickets FeedbackTicket[]
  
  @@map("User")
  @@index([email])
  @@index([active])
}

model Client {
  id                String   @id @default(cuid())
  tenantId          String   // NEW: Tenant isolation
  name              String
  phone             String
  email             String?
  normalizedPhone   String?
  normalizedEmail   String?
  isProvisional     Boolean  @default(false)
  province          String
  canton            String
  district          String
  address           String?
  business          String?
  username          String?
  notes             String?
  totalOrders       Int      @default(0)
  totalSpent        Float    @default(0)
  averageOrderValue Float    @default(0)
  firstOrder        DateTime
  lastOrder         DateTime
  isActive          Boolean  @default(true)
  isFavorite        Boolean  @default(false)
  isAutoGenerated   Boolean  @default(false)
  lastUpdated       DateTime @default(now())
  createdBy         String
  createdAt         DateTime @default(now())
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]
  orders Order[]
  
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, phone])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, normalizedEmail])
  @@index([tenantId, isFavorite])
  @@index([tenantId, totalSpent])
  @@index([tenantId, totalOrders])
  @@index([tenantId, isActive, lastOrder, id])
}

// A conflict is a review task, never an instruction to merge records. The
// candidate IDs are retained as JSON so no relationship is inferred silently.
model ClientIdentityConflict {
  id                 String   @id @default(cuid())
  tenantId           String
  orderId            String?
  normalizedPhone    String?
  normalizedEmail    String?
  candidateClientIds Json
  reason             String
  status             String   @default("open")
  resolvedBy         String?
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, orderId])
}

// Durable idempotency ledger shared by every non-bot order adapter. A single
// tenant feature flag enables the complete adapter set; channels are never
// switched independently.
model OrderLifecycleOperation {
  id             String   @id @default(cuid())
  tenantId       String
  adapter        String
  operation      String
  idempotencyKey String
  orderId        String?
  result         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, adapter, idempotencyKey])
  @@index([tenantId, orderId])
}

// Records the exact stock movement owned by a v2 order. Updating an order
// applies only the delta from these rows, preventing duplicate decrements.
model OrderInventoryAllocation {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String
  inventoryItemId String
  quantity        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, orderId, inventoryItemId])
  @@index([tenantId, inventoryItemId])
}

model InventoryItem {
  id              String   @id @default(cuid())
  tenantId        String   // NEW: Tenant isolation
  name            String
  description     String?
  category        String
  sku             String
  currentStock    Int      @default(0)
  minStock        Int      @default(0)
  maxStock        Int?
  unitCost        Float
  sellingPrice    Float
  supplier        String?
  location        String?
  reorderPoint    Int      @default(0)
  reorderQuantity Int      @default(0)
  isActive        Boolean  @default(true)
  isFavorite      Boolean  @default(false)
  totalSold       Int      @default(0)
  lastSold        DateTime?
  lastUpdated     DateTime @default(now())
  createdBy       String
  createdAt       DateTime @default(now())
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderAllocations OrderInventoryAllocation[]
  
  @@unique([tenantId, sku]) // SKU unique within tenant
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@index([tenantId, isFavorite])
  @@index([tenantId, currentStock])
}

model Seller {
  id       String  @id @default(cuid())
  tenantId String  // NEW: Tenant isolation
  name     String
  active   Boolean @default(true)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([tenantId, active])
}

model ShippingMethod {
  id        String  @id @default(cuid())
  tenantId  String  // NEW: Tenant isolation
  name      String
  carrier   String?
  basePrice Float   @default(0)
  active    Boolean @default(true)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, name])
}

// ============================================================================
// PRODUCT CONFIGURATION MODELS (Updated with tenantId)
// ============================================================================

model ProductOptionSet {
  id      String          @id @default(cuid())
  tenantId String         // NEW: Tenant isolation
  key     String
  name    String
  active  Boolean         @default(true)
  options ProductOption[]
  productFields ProductField[]
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, key]) // Key unique within tenant
  @@index([tenantId])
  @@index([tenantId, active])
}

model ProductOption {
  id         String            @id @default(cuid())
  tenantId   String            // Tenant isolation
  setId      String
  set        ProductOptionSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  label      String
  value      String
  priceDelta Float             @default(0)
  metadata   Json?
  active     Boolean           @default(true)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([setId])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([active])
}

model ProductField {
  id          String            @id @default(cuid())
  tenantId    String            // NEW: Tenant isolation
  key         String
  label       String
  type        String
  required    Boolean           @default(false)
  order       Int               @default(0)
  optionSetId String?
  optionSet   ProductOptionSet? @relation(fields: [optionSetId], references: [id])
  multiSelect Boolean           @default(false)
  active      Boolean           @default(true)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, key]) // Key unique within tenant
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, order])
}

model BusinessInfo {
  id          String   @id @default(cuid())
  tenantId    String   // NEW: Tenant isolation
  name        String
  type        String
  label       String
  placeholder String?
  options     String?
  required    Boolean  @default(false)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, order])
}

model OrderStatus {
  id       String   @id @default(cuid())
  tenantId String   // NEW: Tenant isolation
  key      String
  label    String
  color    String?
  order    Int      @default(0)
  isActive Boolean  @default(true)
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, key]) // Key unique within tenant
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, order])
}

// Classification is keyed by the normalized value stored on Order.status,
// not only by configured OrderStatus rows. This keeps inactive, custom, and
// previously unseen values visible until the tenant explicitly classifies them.
model TenantOrderStatusClassification {
  id                    String   @id @default(cuid())
  tenantId              String
  statusValue           String
  normalizedStatusValue String
  isTerminal            Boolean
  approvedAt            DateTime
  approvedBy            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, normalizedStatusValue])
  @@index([tenantId, isTerminal])
}

// ============================================================================
// SHIPPING MODELS (Updated with tenantId)
// ============================================================================

model ShippingConfig {
  id          String   @id @default(cuid())
  tenantId    String   // NEW: Tenant isolation
  carrier     String
  name        String
  email       String?
  password    String?
  apiKey      String?
  baseUrl     String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([tenantId, carrier])
  @@index([tenantId, isActive])
}

model ShippingGuia {
  id            String   @id @default(cuid())
  tenantId      String   // NEW: Tenant isolation
  orderId       String
  carrier       String
  guiaNumber    String?
  trackingNumber String?
  status        String   @default("created")
  cost          Float?
  weight        Float?
  dimensions    String?
  serviceType   String?
  progress      String?  // Current step: 'Creating guía...', 'Downloading PDF...', etc.
  errorMessage  String?  @db.Text
  pdfData       Bytes?   // Store PDF as binary data
  pdfFileName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([tenantId, orderId])
  @@index([tenantId, carrier])
  @@index([tenantId, status])
}

// ============================================================================
// AUDIT LOG (Updated with tenantId)
// ============================================================================

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String      // NEW: Tenant isolation
  action     AuditAction
  entityType String
  entityId   String
  entityName String?
  oldValues  Json?
  newValues  Json?
  reason     String?
  userId     String?     // Optional: null for bot/system operations
  userName   String
  userRole   String      // Changed from enum to string for flexibility
  timestamp  DateTime    @default(now())
  ipAddress  String?
  userAgent  String?
  
  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id]) // Optional for bot/system ops
  
  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, entityType])
  @@index([tenantId, userId])
  @@index([tenantId, timestamp])
}



// ============================================================================
// ENUMS
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  BULK_DELETE
  BULK_UPDATE
  BULK_TOGGLE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

// Note: UserRole enum removed - now using MemberRole in Membership model

// ============================================================================
// BILLING & INVOICES (NEW!)
// ============================================================================

// Billing Transactions
model BillingTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  amount          Float
  currency        String   @default("CRC")
  status          String   // success, pending, failed, refunded
  description     String?
  paymentMethod   String?  // card, transfer, cash
  stripePaymentId String?
  
  // Billing period
  periodStart     DateTime
  periodEnd       DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// Invoices/Facturas
model Invoice {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceNumber   String   // INV-2025-001
  orderId         String?  // Optional: linked to order
  
  // Customer info
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerIdNumber String? // Cédula/ID
  
  // Invoice details
  items           Json     // Array of line items
  subtotal        Float
  tax             Float    @default(0)
  discount        Float    @default(0)
  total           Float
  
  // Payment
  paymentStatus   String   @default("pending") // pending, paid, partial, overdue
  paymentMethod   String?
  paidAmount      Float    @default(0)
  paidAt          DateTime?
  
  // Metadata
  notes           String?
  dueDate         DateTime?
  currency        String   @default("CRC")

  // Version 1 is historical/client-supplied arithmetic. Version 2 is the
  // gross, IVA-inclusive Betsy calculation and is immutable once persisted.
  calculationVersion Int      @default(1)
  emailStatus       String   @default("not_sent")
  emailProviderId   String?
  emailedAt         DateTime?
  emailError        String?
  // Durable idempotency key for bot/provider generated invoices. Null keeps
  // historical and dashboard-created invoices backward compatible.
  sourceOperationKey String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String   // User who created it
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id])
  
  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, sourceOperationKey])
  @@index([tenantId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerName])
}

// Usage Tracking
model UsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String   // orders_created, users_added, api_calls
  count     Int      @default(1)
  period    String   // 2025-10 (year-month)
  createdAt DateTime @default(now())
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, metric, period])
  @@index([tenantId])
  @@index([period])
}

// Webhook Logs for troubleshooting
model WebhookLog {
  id        String   @id @default(cuid())
  tenantId  String
  level     String   // info, warn, error
  message   String
  data      String?  // JSON data
  source    String   // tilopay-webhook, stripe-webhook, etc.
  createdAt DateTime @default(now())
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([level])
  @@index([source])
  @@index([createdAt])
}

model SocialAccount {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  platform     String
  accountId    String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  linkedAt     DateTime @default(now())
  isActive     Boolean  @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id])
  messages ChatMessage[]

  @@unique([platform, accountId, tenantId])
  @@index([tenantId])
}

model ChatMessage {
  id               String   @id @default(cuid())
  tenantId         String
  socialAccountId  String
  clientId         String?
  orderId          String?
  direction        String
  content          String
  metadata         Json?
  sentAt           DateTime
  receivedAt       DateTime?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  client  Client?       @relation(fields: [clientId], references: [id])
  order   Order?        @relation(fields: [orderId], references: [id])

  @@index([tenantId, socialAccountId, sentAt(sort: Desc)])
  @@index([tenantId])
}

// ============================================================================
// INTEGRATION MODELS (NEW!)
// ============================================================================

model ApiKey {
  id        String   @id @default(cuid())
  tenantId  String
  keyHash   String   @unique  // SHA256 hash of the actual API key
  name      String   // Human-readable name for the key
  active    Boolean  @default(true)
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([keyHash])
}

model IntegrationLog {
  id        String   @id @default(cuid())
  tenantId  String?  // Nullable for unauthenticated requests
  action    String   // ORDER_CREATED, VALIDATION_ERROR, API_ERROR, etc.
  data      Json?    // Additional context data
  createdAt DateTime @default(now())
  
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// BOT SESSION MODEL (Telegram/WhatsApp AI Assistant)
// ============================================================================

model BotSession {
  id           String   @id @default(cuid())
  platform     String   // "telegram" | "whatsapp"
  platformId   String   // telegram_chat_id or whatsapp_phone as string
  userId       String?  // Optional - team members might not have Betsy accounts
  tenantId     String
  connectedAt  DateTime @default(now())
  isActive     Boolean  @default(true)

  // Existing unlinked sessions are grandfathered by the additive SQL. New
  // code-based sessions are explicitly COUNTED and use a constrained virtual
  // role rather than inheriting MANAGER permissions.
  accessRole    String?
  seatPolicy    String?
  grandfatheredAt DateTime?
  seatOverageAt DateTime?
  
  // User identification (for audit trail)
  providedName String?  // Name provided during bot setup
  displayName  String?  // User's display name from the platform (Telegram first_name)
  username     String?  // @username on Telegram
  
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([platform, platformId])
  @@index([tenantId])
  @@index([userId])
  @@index([platform, isActive])
}

// Authenticated provider updates are persisted before acknowledgement. The
// cron/post-response claimant owns retries; payload is cleared after terminal
// processing to minimize retained message content.
model BotInboxMessage {
  id                String   @id @default(cuid())
  tenantId          String
  platform          String
  providerMessageId String
  conversationKey   String
  payload           Json?
  status            String   @default("pending")
  attempts          Int      @default(0)
  availableAt       DateTime @default(now())
  leaseToken        String?
  leaseExpiresAt    DateTime?
  processingStartedAt DateTime?
  processedAt       DateTime?
  failedAt          DateTime?
  lastErrorCode     String?
  lastErrorAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries BotInboxDelivery[]

  @@unique([platform, providerMessageId])
  @@index([status, availableAt, createdAt])
  @@index([platform, conversationKey, status, createdAt])
  @@index([tenantId, status])
}

model BotInboxDelivery {
  id                String   @id @default(cuid())
  inboxMessageId    String
  deliveryKey       String
  kind              String
  contentHash       String
  status            String   @default("sending")
  providerDeliveryId String?
  lastErrorCode     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sentAt            DateTime?

  inboxMessage BotInboxMessage @relation(fields: [inboxMessageId], references: [id], onDelete: Cascade)

  @@unique([inboxMessageId, deliveryKey])
  @@index([status, updatedAt])
}

// ============================================================================
// FEEDBACK & CHANGELOG
// ============================================================================

model FeedbackTicket {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  category      String    // bug, feature, question, other
  subject       String
  description   String    @db.Text
  screenshotUrl String?
  status        String    @default("open") // open, in_progress, resolved, closed
  adminNotes    String?   @db.Text
  priority      String    @default("normal") // low, normal, high, critical
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model ChangelogEntry {
  id          String   @id @default(cuid())
  tenantId    String?  // null = global (visible to all tenants)
  title       String
  description String   @db.Text
  category    String   // feature, fix, improvement, announcement
  createdAt   DateTime @default(now())
  createdBy   String   // admin user id

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@index([createdAt])
}
