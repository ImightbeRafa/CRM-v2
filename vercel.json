{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "sfo1"
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/finance/v1/costs/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/finance/v1/facturacion/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/finance/v1/orders/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/backup/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/cron/backup/hot/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/cron/bot-inbox/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/shipping/generate-guia/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/logistics/guias/generate-bulk/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/logistics/tracking/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/logistics/tarifa/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/logistics/correos-config/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/logistics/correos-test/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/logistics/reports/pdf/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/backup/hot",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/process-subscription-expiry",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/bot-inbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/logistics-report",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/logistics-finalize",
      "schedule": "0 18 * * 0"
    }
  ]
}
