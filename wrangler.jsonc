{
  "name": "betsy-crm-daytime-smoke",
  "workers_dev": true,
  "preview_urls": true,
  "main": "src/cf-container-worker.ts",
  "compatibility_date": "2026-09-25",
  "triggers": {
    // Unique schedules matching vercel.json (9 paths; "0 2 * * *" fans out to 2).
    // Handler no-ops while DISABLE_CRONS=1 — safe to deploy before DNS flip.
    "crons": [
      "0 2 * * *",
      "0 14 * * *",
      "*/5 * * * *",
      "*/1 * * * *",
      "30 3 * * *",
      "0 5 * * *",
      "0 18 * * SUN",
      "0 6 * * *"
    ]
  },
  "containers": [
    {
      "class_name": "BetsyCrmContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BETSY_CRM_CONTAINER",
        "class_name": "BetsyCrmContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BetsyCrmContainer"]
    }
  ],
  // www traffic flip: zone route on already-proxied hostname (custom_domain blocked by
  // existing Vercel-managed DNS records; OAuth token lacks Zone DNS delete).
  "routes": [
    { "pattern": "www.betsycrm.com/*", "zone_name": "betsycrm.com" }
  ]
}
